  "type": "structural",
  "vulnerabilities": ["IDAF"],
  "forbidden_name_prefixes": [
    "ssl.SSLv2_METHOD", "ssl.SSLv3_METHOD", "ssl.SSLv23_METHOD", "ssl.TLSv1_METHOD", "ssl.TLSv1_1_METHOD",
