[
{
  "rule_id": "TEMPORARYFILE-MOD-001",
  "type": "structural",
  "vulnerabilities": ["SDIF"],
  "description": "temporary file mode vulnerability",
  "forbidden_functions": ["tempfile.NamedTemporaryFile"],
  "safe_contexts": [
    {
      "type": "function_has_call_matching_ast",
      "call": ["os.chmod"],
      "contains_names": ["stat.S_IRUSR"]
    },
    {
      "type": "function_has_call_matching_ast",
      "call": ["os.chmod"],
      "contains_names": ["stat.S_IWUSR"]
    },
    {
      "type": "function_has_call_matching_ast",
      "call": ["os.chmod"],
      "contains_numbers": ["0o600"]
    },
    {
    "type": "call_has_kwargs",
    "call": ["tempfile.NamedTemporaryFile"],
    "require": "all",
    "kwargs": {
      "mode": "\"w+\"",
      "encoding": "\"utf-8\"",
      "delete": "False"
    }
  }
  ]
},
 {
  "rule_id": "TEMPORARYFILE-001",
  "type": "structural",
  "vulnerabilities": ["SDIF"],
  "description": "temporary file vulnerability",
  "forbidden_functions": ["temp_file.write"],
  "safe_contexts": [
