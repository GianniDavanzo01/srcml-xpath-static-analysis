{
  "rule_id": "GIT-CLONE-001",
  "type": "structural",
  "vulnerabilities": ["SDIF"],
  "forbidden_functions": [
    {
      "type": "call_matches_ast",
      "call": ["Repo.clone_from"],
      "args_text_contains": ["kwargs"]
    }
  ],
  "safe_contexts": [
    {
      "type": "binary_comparison",
      "operators": ["!="],
      "left_contains": [
        "kwargs['depth']", 
        "kwargs[\"depth\"]"
      ],
      "right_exact": ["1"]
    }
  ]
},
{
  "rule_id": "GIT-CLONE-002",
