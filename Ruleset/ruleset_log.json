[
 {
  "rule_id": "LOGGING-INFO-001",
  "type": "structural",
  "vulnerabilities": ["SLMF"],
  "forbidden_functions": [
    "logging.info"
  ],
  "safe_contexts": [
    {
      "type": "node_matches_xpath",
      "xpath": "ancestor-or-self::src:call[1][ contains(string(./src:argument_list), '%s') and ./src:argument_list/src:argument[position()>1] ]"
    }
  ]
 },
{
  "rule_id": "LOGORU-LOGGER-001",
  "type": "structural",
  "vulnerabilities": [
    "SLMF"
  ],
  "forbidden_imports": [
    "loguru.logger"
  ],
  "safe_contexts": [
    {
      "type": "file_has_logger_info_add"
    }
  ]
},
{
  "rule_id": "LOGGING-PASSWORD-001",
  "type": "structural",
  "vulnerabilities": [
    "SLMF"
  ],
  "forbidden_functions": [
    {"type": "call_matches_ast", 
    "call": ["logging.debug"], 
    "args_text_contains": ["password", "Password"]}
  ],
  "safe_contexts": [
    {
      "type": "args_contain_masking"
    }
  ]
},
{
  "rule_id": "LOGGING-WARNING-001",
  "type": "structural",
  "vulnerabilities": [
    "SLMF"
  ],
  "forbidden_functions": ["logger.warning"],
  "safe_contexts": [
    {
      "type": "args_contain_call_with_literal_arg",
      "call": "re.sub"
    }
  ]
},
{
  "rule_id": "LOGGING-REQUEST-001",
  "type": "structural",
  "vulnerabilities": [
    "SLMF"
  ],
  "forbidden_function_defs": [
    {
      "name": "log_requests",
      "is_async": true
    }
  ],
  "safe_contexts": [
    {
      "type": "matches_xpath",
      "xpath": "ancestor-or-self::src:unit[1][contains(., 'logging.Filter')]"
    }
  ]
}

]