[
 {
    "rule_id": "MKDIR-001",
    "type": "structural",
    "vulnerabilities": ["SDIF"],
    "description": "Creazione di directory con mkdir() senza exist_ok=False esplicito: rischio di race condition / symlink attack (TOCTOU) mascherata da creazione silenziosa",
    "forbidden_functions": ["mkdir"],
    "safe_contexts": [
        { "type": "call_with_kwarg", "call": ["mkdir"], "kwargs": { "exist_ok": "False" } }
    ]
 },
 {
  "rule_id": "MAKEDIRS-001",
  "type": "structural",
  "vulnerabilities": ["SECM"],
  "description": "makedirs vulnerability",
  "forbidden_functions": ["os.makedirs"],
  "safe_contexts": [
    {
      "type": "call_with_kwarg",
      "call": ["os.makedirs"],
      "kwargs": { "mode": "0o700" }
    },
    {
      "type": "current_call_matches_ast", 
      "contains_names": ["stat.S_IRUSR"]
    },
    {
      "type": "current_call_matches_ast", 
      "contains_names": ["stat.S_IWUSR"]
    }
  ]
 },
 {
  "rule_id": "OS-CHMOD-001",
  "type": "structural",
  "vulnerabilities": ["SECM"],
  "description": "OS chmod vulnerability",
  "forbidden_functions": [
    {
      "type": "call_matches_ast", 
      "call": ["os.chmod"], 
      "contains_numbers": ["0", "0000", "0o000", "755", "0o755", "777", "0o777", "0o400", "128", "664", "0o644"]
    }
  ],
  "safe_contexts": []
 },
 {
  "rule_id": "OS-ENV-GET-001",
