[
 {
  "rule_id": "SOCKET-001",
  "type": "structural",
  "vulnerabilities": ["SDIF"],
  "forbidden_functions": [
    "socket.socket","socket.connect","socket.bind",
    "socket.listen","socket.accept","socket.send",
    "socket.recv","socket.sendto","socket.recvfrom",
    "socket.sendmsg","socket.recvmsg","socket.setsockopt",
    "socket.getsockopt","socket.getsockname","socket.getpeername",
    "socket.shutdown"
  ],
  "safe_contexts": [
    "try"
  ]
 },
 {
  "rule_id": "PARSE-UDP-001",
  "type": "structural",
  "vulnerabilities": ["BRAC"],
  "forbidden_function_defs": [
    {
      "name": "parseUDPpacket",
      "max_params": 1,
      "exact_body": "pass"
    }
  ]
},
{
  "rule_id": "SOCKET-GET-ADDRESS-INFO-001",
  "type": "structural",
  "vulnerabilities": ["BRAC"],
  "forbidden_functions": [
    {
      "type": "call_matches_ast",
      "call": ["socket.getaddrinfo"],
      "exact_args_count": 2,
      "contains_names": ["host", "port"]
    }
  ],
  "safe_contexts": [
    {
      "type": "binary_comparison",
      "operators": [">"],
      "left_exact": ["len(host)"],
      "right_exact": ["255"]
    }
  ]
}
 
]