{
  "rule_id": "SQL-001-call",
  "type": "taint",
  "vulnerabilities": ["INJC"],
  "source_form": "call",
  "sources": [
    "input",
    "request.args.get"
  ],
  "sinks": [
    { "type": "concat", "requires_text_any": ["SELECT", "DELETE", "UPDATE", "INSERT"] },
    { "type": "fstring", "requires_text_any": ["SELECT", "DELETE", "UPDATE", "INSERT"] },
    { "type": "call_arg", "requires_text_any": ["SELECT", "DELETE", "UPDATE", "INSERT"] }
  ],
"safe_contexts": [
  { "type": "parametrized_query" },
  {
    "type": "node_matches_xpath",
