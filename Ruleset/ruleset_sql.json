{
    "rule_id": "SQL-002",
    "type": "structural",
    "vulnerabilities": [
        "INJC"
    ],
    "forbidden_functions": [
        "sql.parse"
    ],
    "safe_contexts": [
        {
            "type": "node_matches_xpath",
            "xpath": "ancestor::src:call[.//src:name[text()='re.sub' or text()='escape']]"
        }
    ]
},
{
    "rule_id": "SQL-PARAMETRIZED-QUERY-002",
    "type": "structural",
    "vulnerabilities": [
        "INJC"
    ],
    "forbidden_functions": [
        {
            "type": "call_matches_ast",
            "call": "execute",
            "args_text_contains": [
                "SELECT",
                "DELETE",
                "UPDATE",
                "INSERT"
            ]
        }
    ],
    "safe_contexts": [
        {
            "type": "parametrized_query"
        },
        {
            "type": "node_matches_xpath",
            "xpath": "self::src:call[.//src:name[last()][text()='execute']][ (contains(string(./src:argument_list), '%s') or contains(string(./src:argument_list), '?')) and ./src:argument_list/src:argument[position()>1] ]"
        },
        {
            "type": "node_matches_xpath",
            "xpath": "ancestor::src:call[.//src:name[text()='escape' or text()='replace']]"
        }
    ]
},
{
    "rule_id": "SQL-PARSE-FORMAT-002",
    "type": "structural",
    "vulnerabilities": [
        "INJC"
    ],
    "forbidden_functions": [
        "sqlparse.format"
    ],
    "safe_contexts": [
        {
            "type": "call_has_kwargs",
            "call": [
                "sqlparse.format",
                "format"
            ],
            "kwargs": {
                "strip_comments": "False"
            }
        }
    ]
},
{
  "rule_id": "MYSQL-DB-003",
  "type": "structural",
  "vulnerabilities": ["SDIF"],
  "forbidden_functions": ["MySQLdb.connect"],
  "safe_contexts": [
    { "type": "matches_xpath", "xpath": ".//src:call[.//src:name[last()][text()='getenv']]" }
  ]
},
{
    "rule_id": "SQL-CONNECTOR-003",
    "type": "structural",
    "vulnerabilities": [
        "SDIF"
    ],
    "forbidden_functions": [
        "mysql.connector.connect"
    ],
    "safe_contexts": [
        {
            "type": "call_has_kwargs",
            "call": [
                "mysql.connector.connect",
                "connect"
            ],
            "kwargs": {
                "ssl_disabled": "False"
            }
        }
    ]
}
