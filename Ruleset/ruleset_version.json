[
    {
  "rule_id": "PYTHON-001",
  "type": "structural",
  "description": "python version vulnerability - Import di moduli considerati vulnerabili senza un controllo esplicito sulla versione di Python",
  "vulnerabilities": [
    "SDIF"
  ],
  "forbidden_imports": [
    "http.server",
    "wave",
    "xml.parsers.expat",
    "urllib3"
  ],
  "safe_contexts": [
  {
    "type": "matches_xpath",
    "xpath": "ancestor-or-self::src:unit[1][contains(translate(., concat(' ', '&#10;', '&#13;'), ''), 'sys.version.split()[0]')]"
  },
  {
    "type": "matches_xpath",
    "xpath": "ancestor-or-self::src:unit[1][contains(translate(., concat(' ', '&#10;', '&#13;'), ''), 'sys.version_info')]"
  }
  ]
},
