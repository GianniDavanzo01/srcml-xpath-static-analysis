[
{
  "rule_id": "BIND-FUNCTION-001",
  "type": "structural",
  "vulnerabilities": ["BRAC"],
  "description": "Bind function",
  "forbidden_functions": [
    {
      "type": "call_matches_ast",
      "call": ["bind"],
      "args_text_contains": ["'0.0.0.0'", "''"]
    }
  ],
  "safe_contexts": []
},
{
  "rule_id": "PICKLE-FAILURE-001",
  "type": "structural",
  "vulnerabilities": ["SDIF"],
  "description": "Failures",
  "forbidden_functions": [
    "pickle.loads", "pickle.load", "pickle.dump", "pickle.dumps", "pickle.Unpickler",
    "cPickle.loads", "cPickle.load", "cPickle.dump", "cPickle.dumps", "cPickle.Unpickler"
  ],
  "safe_contexts": [
    {
      "type": "function_has_call_matching_ast",
      "call": ["os.path.join"]
    },
    {
      "type": "matches_xpath",
      "xpath": ".//src:assert[ contains(translate(string(.), ' ', ''), 'isinstance(obj,(dict,list,tuple,set,str,int,float,type(None)))') ]"
    }
  ]
},
{
  "rule_id": "TABLIB-DATABOOK-LOAD-001",
  "type": "structural",
  "vulnerabilities": ["SDIF"],
  "description": "Failures - Deserializzazione non sicura tramite tablib.Databook().load() senza l'utilizzo del parametro sicuro loader=yaml.SafeLoader",
  "xpath_rules": [
    ".//src:call[src:name[text()='load'] and preceding-sibling::src:operator[1][text()='.'] and preceding-sibling::src:call[1][.//src:name[text()='tablib'] and .//src:name[text()='Databook']]]"
  ],
  "safe_contexts": [
    {
      "type": "call_has_kwargs",
      "call": ["load"],
      "kwargs": {
        "loader": "yaml.SafeLoader"
      }
    }
  ]
},
{
  "rule_id": "XML-PARSER-001",
  "type": "structural",
  "vulnerabilities": ["SECM"],
  "description": "Parser vulnerability - Inizializzazione di etree.XMLParser() potenzialmente vulnerabile a XXE (XML External Entity)",
  "forbidden_functions": [
    "etree.XMLParser"
  ],
  "safe_contexts": [
    {
      "type": "current_call_matches_ast",
      "args_text_contains": [
        "resolve_entities=False",
        "no_network=True",
        "dtd_validation=True"
      ]
    }
  ]
},
{
  "rule_id": "LXML-CLEANER-001",
  "type": "structural",
  "vulnerabilities": ["SECM"],
  "description": "lxml cleaner vulnerability - Importazione di Cleaner da lxml.html.clean senza la messa in sicurezza obbligatoria (scripts=True e javascript=True)",
  "forbidden_imports": [
    "lxml.html.clean.Cleaner"
  ],
  "required_safe_calls": [
    {
      "call": ["Cleaner"],
      "kwargs": {
        "scripts": "True",
        "javascript": "True"
      }
    }
  ]
}

]