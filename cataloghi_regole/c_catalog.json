{
    "sources":{
        "http_input": [
            "getenv","recv","recvfrom","read",
            "fread","fgets","scanf","gets"]
    },
    "sinks":{
        "file_system_access": [
            {
                "type": "call_with_var_arg",
                "call":["fopen","open","remove","unlink","rename","mkdir","rmdir","stat","lstat"]
            }
        ],
        "path_concatenation": [
            {
                "type": "call_with_var_arg",
                "call":["strcat","strncat","sprintf","snprintf"]
            }
        ],
        "os_command_execution": [
            {
                "type": "call_with_var_arg",
                "call": ["system", "popen", "execl", "execlp", "execle", "execv", "execvp", "execvpe", "execve"]
            }
        ],
        "html_output": [],
        "sql_execution": [
            {"type": "call_with_var_arg", "call": ["sqlite3_exec", "sqlite3_prepare", "sqlite3_prepare_v2", "sqlite3_prepare_v3"]}
        ],
        "http_request": [
            {"type": "call_with_var_arg", "call": ["curl_easy_setopt", "curl_easy_perform"]}
        ],
        "ldap_execution": [
            {
            "type": "call_with_var_arg",
            "call": ["ldap_search","ldap_search_s","ldap_search_st","ldap_search_ext","ldap_search_ext_s"]
            }
        ]
    },
    "forbidden_functions":{
        "weak_key_generation": [
                {
                    "type": "call_matches_ast",
                    "call": ["RSA_generate_key","DH_generate_parameters"],
                    "arg_less_than": {"index": 0, "value": 2048}
                },
                {
                    "type": "call_matches_ast",
                    "call": ["RSA_generate_key_ex", "DH_generate_parameters_ex"],
                    "arg_less_than": {"index": 1, "value": 2048}
                }
        ],
        "weak_ciphers_and_modes": [
            "DES_encrypt1", "DES_encrypt2", "DES_encrypt3", "DES_ecb_encrypt",
            "EVP_des_ecb", "EVP_des_cbc","EVP_rc4", "EVP_rc2_ecb",
            "RC4","EVP_bf_ecb"
        ],
        "weak_hash_functions": [
            "MD5", "MD5_Init", "MD5_Update", "MD5_Final",
            "SHA1", "SHA1_Init", "SHA1_Update", "SHA1_Final",
            "EVP_md5", "EVP_sha1"
        ],
        "weak_prngs": [
            "rand", "srand", "random", "srandom",
            "drand48", "lrand48", "mrand48", "rand_r"
        ],
        "insecure_temp_functions": ["tmpnam", "tempnam", "mktemp"],
        "unsafe_xml_parsers": [
            {
                "type": "call_matches_ast",
                "call": ["xmlReadFile", "xmlReadMemory", "xmlReadDoc", "xmlCtxtReadFile", "xmlCtxtReadMemory"],
                "contains_names": ["XML_PARSE_NOENT", "XML_PARSE_DTDLOAD"]
            },
            "xmlSubstituteEntitiesDefault"
        ],
        "insecure_cookie_configuration":[
            {
                "type": "call_matches_ast",
                "call": ["mg_printf", "MHD_add_response_header", "kore_http_response_header"],
                "contains_string_containing": ["Set-Cookie"]
            }
        ],
        "socket_primitives": [
            "socket", "connect", "bind", "listen", "accept",
            "send", "recv", "sendto", "recvfrom", "sendmsg", "recvmsg",
            "setsockopt", "getsockopt", "getsockname", "getpeername", "shutdown"
        ],
        "insecure_network_protocols": [
            {
            "type": "call_matches_ast",
            "call": ["curl_easy_setopt"],
            "contains_names": ["CURLOPT_URL"],
            "contains_string_containing": ["http://", "ftp://", "telnet://"]
            },
            {
            "type": "call_matches_ast",
            "call": ["curl_easy_setopt"],
            "contains_names": ["CURLOPT_USE_SSL"]
            }
        ],
        "logging_calls_with_sensitive_content": [
            {
                "type": "call_matches_ast",
                "call": ["printf", "fprintf", "syslog"],
                "contains_any_name": ["password", "Password", "pwd", "secret", "Secret",
                            "token", "Token", "api_key", "apikey", "private_key"]
            }
        ]
    },
    "excluded_functions":{
        "safe_prng_exceptions": []
    },
    "sanitizers":{
        "cast_to_integer":["atoi","atol","atoll","strtol","strtoll","strtoul"],
        "path_sanitizers": ["basename","realpath"],
        "shell_escape_sanitizers": [],
        "XSS_sanitizers": [],
        "ldap_escape_sanitizers": []
    },
    "safe_contexts":{
        "sql_parameterization": [],
        "secure_cookie_contexts": [
                {
                "type": "matches_xpath",
                "xpath": ".//src:call[.//src:name[text()='mg_printf' or text()='MHD_add_response_header' or text()='kore_http_response_header']][.//src:literal[@type='string'][contains(.,'Secure')]][.//src:literal[@type='string'][contains(.,'HttpOnly')]]"
                }
            ],
            "try_block": [],
            "safe_permission_defaults": [
                {"type": "current_call_matches_ast", "call": ["chmod", "fchmod"], "contains_names": ["S_IRUSR"]},
                {"type": "current_call_matches_ast", "call": ["chmod", "fchmod"], "contains_names": ["S_IWUSR"]}
                ],
                "curl_non_url_option": [
                    {
                    "type": "node_matches_xpath",
                    "xpath": "not(ancestor::src:call[1]//src:argument_list//src:name[text()='CURLOPT_URL'])"
                    }
                ],
                "starttls_upgrade": [
                    {
                    "type": "function_has_call_matching_ast",
                    "call": ["curl_easy_setopt"],
                    "contains_names": ["CURLOPT_USE_SSL", "CURLUSESSL_ALL"]
                    },
                    {
                    "type": "function_has_call_matching_ast",
                    "call": ["curl_easy_setopt"],
                    "contains_names": ["CURLOPT_USE_SSL", "CURLUSESSL_TRY"]
                    }
                ]
    },
    "patterns":{
        "insecure_certificate_validation": {
            "forbidden_functions": [
                {
                "type": "call_matches_ast",
                "call": ["SSL_CTX_set_verify", "SSL_set_verify"],
                "contains_names": ["SSL_VERIFY_NONE"]
                },
                {
                "type": "call_matches_ast",
                "call": ["curl_easy_setopt"],
                "exact_args_count": 3,
                "contains_names": ["CURLOPT_SSL_VERIFYPEER"],
                "contains_numbers": ["0"]
                },
                {
                "type": "call_matches_ast",
                "call": ["curl_easy_setopt"],
                "exact_args_count": 3,
                "contains_names": ["CURLOPT_SSL_VERIFYHOST"],
                "contains_numbers": ["0"]
                }
            ]
        },
        "active_debug": {
            "bad_assignments": {
                "debug": "1",
                "DEBUG": "1",
                "debug_mode": "1"
            }
        },
          "insecure_permission_assignment": {
                "forbidden_functions": [
                    {
                        "type": "call_matches_ast",
                        "call": ["chmod", "fchmod"],
                        "contains_numbers": ["0", "0000", "0755", "0777", "0400", "0644"]
                    },
                    {
                        "type": "call_matches_ast",
                        "call": ["open"],
                        "exact_args_count": 3,
                        "contains_numbers": ["0777", "0666"]
                    }
                ]
            },
            "unsafe_deserialization_kwargs":{}
    }
}