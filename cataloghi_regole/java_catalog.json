        ]
      }
    ],
    "client_error_output": [
  {
    "type": "call_with_var_arg",
    "call": [
      "*.getWriter.println", "*.getWriter.print", "*.getWriter.write",
      "*.getWriter.printf", "*.getWriter.format", "*.getWriter.append",
      "*.getOutputStream.write", "*.getOutputStream.print", "*.getOutputStream.println",
      "*.JspWriter.print", "*.JspWriter.println",
      "*.HttpServletResponse.sendError",
      "*.ResponseEntity", "*.ResponseEntity.ok", "*.ResponseEntity.ok.body",
