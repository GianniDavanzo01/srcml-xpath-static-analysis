        "arg_index": 1,
        "call": ["*.Files.copy"]
      },
      {
        "type": "call_with_var_arg",
        "call": [
          "*.FileInputStream",
          "*.FileOutputStream",
          "*.FileReader",
          "*.FileWriter",
          "*.RandomAccessFile",
          "*.File",
          "*.Files.move",
