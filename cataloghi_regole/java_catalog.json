{
  "sources": {
    "http_input": [
      "HttpServletRequest.getParameter",
      "HttpServletRequest.getParameterValues",
      "HttpServletRequest.getHeader",
      "HttpServletRequest.getCookies",
      "request.getParameter",
      "request.getHeader"
    ]
  },
  "sinks": {
    "sql_execution": [
      {
        "type": "call_with_var_arg",
        "call": [
          "executeQuery",
          "executeUpdate",
          "execute",
          "prepareStatement",
          "createQuery",
          "createNativeQuery",
          "jdbcTemplate.query"
        ]
      },
      {"type": "concat", "requires_text_any": ["SELECT", "DELETE", "UPDATE", "INSERT"]}
    ],
    "path_concatenation": [
      "concat",
      {"type": "call_with_var_arg", "call": ["get", "resolve"]}
    ],
    "os_command_execution": [
      {"type": "call_with_var_arg", "call": ["exec", "ProcessBuilder"]}
    ],
    "file_system_access": [
      {"type": "call_with_var_arg", "call": [
        "FileInputStream", "FileOutputStream", "FileReader", "FileWriter", "RandomAccessFile",
        "newInputStream", "readAllBytes", "write", "delete", "copy", "move",
        "createNewFile", "File"
      ]}]
  },
  "forbidden_functions": {
    "socket_primitives": [
      "Socket","ServerSocket","DatagramSocket","SocketChannel",
      "ServerSocketChannel","socket.connect","serverSocket.bind","serverSocket.accept",
      "socket.getInputStream","socket.getOutputStream","datagramSocket.send","datagramSocket.receive"
    ]
  },
  "sanitizers":{
    "cast_to_integer": ["Integer.parseInt", "Integer.valueOf","Long.parseLong","Long.valueOf"],
    "path_sanitizers": ["getCanonicalPath", "getCanonicalFile", "FilenameUtils.getName"]
  },
  "safe_contexts": {
    "try_block": [
      "try"
    ]
  },
  "patterns": {
    "active_debug": {
      "forbidden_functions": [
        {
          "type": "call_matches_ast",
          "call": ["setDebug", "enableDebug"],
          "exact_args_count": 1,
          "contains_booleans": ["true"]
        }
      ]
    }
  }
}