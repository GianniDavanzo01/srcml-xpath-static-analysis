{
  "sources": {
    "http_input": [
      "HttpServletRequest.getParameter",
      "HttpServletRequest.getParameterValues",
      "HttpServletRequest.getHeader",
      "HttpServletRequest.getCookies",
      "request.getParameter",
      "request.getHeader"
    ],
    "cli_input": [
        "System.getenv","System.getProperty",
        "Scanner.nextLine","Scanner.next",
        "Console.readLine","Console.readPassword"
    ],
    "nullable_returning_calls": ["System.getenv", "Map.get", "Optional.orElse","pattern.matcher"]
  },
  "sinks": {
    "sql_execution": [
      {
        "type": "call_with_var_arg",
        "call": [
          "Statement.executeQuery", "PreparedStatement.executeQuery", "CallableStatement.executeQuery",
          "Statement.executeUpdate", "PreparedStatement.executeUpdate", "CallableStatement.executeUpdate",
          "Statement.execute", "PreparedStatement.execute", "CallableStatement.execute",
          "Connection.prepareStatement",
          "EntityManager.createQuery", "Session.createQuery",
          "EntityManager.createNativeQuery",
          "JdbcTemplate.query",
          "executeQuery", "executeUpdate", "execute",
          "prepareStatement", "createQuery", "createNativeQuery", "jdbcTemplate.query"
        ]
      } 
      ],
    "path_concatenation": [
        {
          "type": "concat",
          "requires_literal_any": ["/", "\\", ".."],
          "requires_text_any": ["File", "Path", "Paths", "FileInputStream", "FileOutputStream", "Reader", "Writer"]
        },
        {
          "type": "call_with_var_arg",
          "call": ["Paths.get", "Path.of"]
        },
        {
          "type": "call_with_var_arg",
          "call": ["resolve", "resolveSibling"],
          "requires_text_any": ["Path", "FileSystem"]
        }
    ],
    "os_command_execution": [
      {"type": "call_with_var_arg", "call": ["exec", "ProcessBuilder","command"]}
    ],
    "file_system_access": [
      {"type": "call_with_var_arg", 
      "call": ["FileInputStream", "FileOutputStream", "FileReader", "FileWriter", "RandomAccessFile",
              "newInputStream", "readAllBytes", "write", "delete", "copy", "move",
              "createNewFile", "File"
      ]}],
 "html_output": [
        {
          "type": "call_with_var_arg",
          "call": ["print", "println", "write", "sendError"],
          "requires_text_any": ["response", "getWriter", "HttpServletResponse", "JspWriter", "out"]
        },
        {
          "type": "call_with_var_arg",
          "call": ["ok", "body"],
          "requires_text_any": ["ResponseEntity", "RestResponse"]
        },
        {
          "type": "call_with_var_arg",
          "call": ["setViewName", "addObject"],
          "requires_text_any": ["ModelAndView"]
        }
      ],
    "http_redirect": [
      {
        "type": "call_with_var_arg",
        "call": ["sendRedirect"]
      }
    ],
    "http_request": [
      {
        "type": "call_with_var_arg",
        "call": ["HttpURLConnection", "URL.openConnection", "openStream", "RestTemplate.getForObject", 
                "RestTemplate.postForObject", "WebClient.get", "WebClient.post","HttpClient.newHttpClient"
        ]
      }
    ],
    "http_header_setters": [
      {
        "type": "call_with_var_arg",
        "call":["HttpServletResponse.addHeader","HttpServletResponse.setHeader","HttpServletResponse.addCookie"]
      },
      {
        "type": "call_with_var_arg",
        "call": ["add","set"],
        "requires_text_any": ["ServerHttpResponse.getHeaders","getHeaders"]
      }

  ],
  "ldap_execution": [
      {
        "type": "call_with_var_arg",
        "call": ["DirContext.search","InitialDirContext.search","LdapContext.search","InitialLdapContext.search"]
      }
    ],
    "csv_writing": [
      {
        "type": "call_with_var_arg",
        "call": ["printRecord","writeNext","writeAll"]
      }
    ],
    "exception_stringify_calls": [
      {"type": "method_call", "method": "getMessage"},
      {"type": "method_call", "method": "toString"},
      {"type": "method_call", "method": "getLocalizedMessage"}
    ],
    "logging_functions": [
      {
        "type": "call_with_var_arg",
        "call": ["Logger.info", "Logger.error", "Logger.warn", "Logger.warning","System.out.println", "System.err.println"]
      }
    ]
  },
  "forbidden_functions": {
    "socket_primitives": [
      "Socket","ServerSocket","DatagramSocket","SocketChannel",
      "ServerSocketChannel","Socket.connect","ServerSocket.bind","ServerSocket.accept",
      "Socket.getInputStream","Socket.getOutputStream","DatagramSocket.send","DatagramSocket.receive"
    ],
    "weak_hash_functions": ["MD5", "SHA-1", "MessageDigest.getInstance"],
    "weak_ciphers_and_modes": ["DES", "DESede", "RC2", "RC4", "Blowfish", "ECB", "Cipher.getInstance"],
    "weak_prngs": ["java.util.Random","Math.random","Random"],
    "weak_key_generation": [
      {
        "type": "call_matches_ast",
        "call": ["KeyPairGenerator.initialize", "KeyGenerator.init"],
        "arg_less_than": 2048
      }
    ],
    "dynamic_code_execution": [
      "ScriptEngine.eval",
      "GroovyShell.evaluate",
      "ExpressionParser.parseExpression",
      "Ognl.getValue",
      "MVEL.eval"
    ],
    "unsafe_xml_parsers": [
      "DocumentBuilderFactory.newDocumentBuilder",
      "SAXParserFactory.newSAXParser",
      "XMLInputFactory.createXMLStreamReader",
      "SchemaFactory.newSchema"
    ],
    "unsafe_deserializers": [
      "ObjectInputStream.readObject","ObjectInputStream.readUnshared",
      "XMLDecoder.readObject","XStream.fromXML","Yaml.load",
      "Kryo.readObject","Kryo.readClassAndObject"
    ],
    "insecure_temp_functions": [
      {
        "type": "call_matches_ast",
        "call": ["File"],
        "contains_names": ["java.io.tmpdir"]
      }
    ],
    "insecure_cookie_configuration":["HttpServletResponse.addCookie","Cookie"],
    "insecure_network_protocols": ["FTPClient","TelnetClient","POP3Client"],
    "logging_calls_with_sensitive_content": [
      {
        "type": "call_matches_ast",
        "call": ["logging.debug", "logging.info", "logging.warning", "logging.error",
                  "logger.debug", "logger.info", "logger.warning", "logger.error"],
        "contains_any_name": ["password", "Password", "pwd", "secret", "Secret",
                            "token", "Token", "api_key", "apikey", "private_key"]
      }
    ],
    "obsolete_functions": ["Thread.stop", "Thread.suspend", "Thread.resume", "Runtime.exec"],
    "weak_password_hashing": [
        {
          "type": "call_matches_ast",
          "call": ["MessageDigest.getInstance"],
          "contains_string_containing": ["MD5", "SHA-1"],
          "contains_any_name": ["password", "passwd", "pwd"]
        }
      ]

  },
  "excluded_functions": {
      "safe_prng_exceptions": ["SecureRandom"],
      "eval_false_positive_exceptions": []
  },
  "forbidden_imports": {
    "weak_crypto_modules": ["org.apache.commons.codec.digest.DigestUtils"]
  },
  "xpath_rules":{
      "off_by_one_loop_condition": [
        ".//src:while[./src:condition//src:operator[text()='<='] and ./src:condition//src:name[text()='length']]",
        ".//src:while[.//src:condition//src:operator[text()='<='] and .//src:condition//src:call[.//src:name[text()='size']]]"
    ]
  },
  "sanitizers":{
    "cast_to_integer": ["Integer.parseInt", "Integer.valueOf","Long.parseLong","Long.valueOf"],
    "path_sanitizers": ["getCanonicalPath", "getCanonicalFile", "FilenameUtils.getName"],
    "shell_escape_sanitizers":[],
    "html_escape": ["HtmlUtils.htmlEscape","StringEscapeUtils.escapeHtml4","encodeForHTML"],
    "XSS_sanitizers": ["HtmlUtils.htmlEscape","StringEscapeUtils.escapeHtml4","encodeForHTML"],
    "url_encode_sanitizers": ["URLEncoder.encode"],
    "crlf_sanitizers": ["encodeForHTTPHeader","URLEncoder.encode","StringUtils.replace","StringEscapeUtils.escapeHtml4","encodeForHTTPHeader" ],
    "ldap_escape_sanitizers":["encodeForLDAP","encodeForDN","LdapEncoder.filterEncode","LdapEncoder.nameEncode"]
  },
  "safe_contexts": {
    "try_block": ["try"],
    "if_block": ["if"],
    "sql_parameterization":[],
    "safe_permission_defaults": [
        {
          "type": "matches_xpath",
          "xpath": ".//src:call[.//src:name[text()='PosixFilePermissions']]"
        }
      ],
    "secure_cookie_contexts": [
          {
            "type": "function_has_call_matching_ast",
            "call": ["setSecure"],
            "contains_booleans": ["true"]
          }
        ],
    "resource_safe_contexts": [
        {
          "type": "function_has_file_size_check",
          "size_properties": ["length", "getSize"]
        }
      ],
      "starttls_upgrade": [
        {
          "type": "function_has_call_matching_ast",
          "call": ["execTLS"]
        }
      ],
      "url_validation": [
        {
          "type": "condition_matches_xpath",
          "scope": "enclosing",
          "xpath": ".//src:call[.//src:name[last()][text()='isValid']][.//src:argument_list//src:name[text()='$VAR']]"
        }
      ],
      "allowlist_validation": [
        {
          "type": "membership_check",
          "scope": "enclosing",
          "require_var_left": true,
          "right_is_bare_identifier": true,
          "allowed_negation": [false]
        }
      ],
      "file_extension_validation": [
        {
          "type": "receiver_of_method_with_arg",
          "method": "endsWith", 
          "arg_value": ".png"
        }
      ],
      "bounds_checked_array_access": [
        {"type": "binary_comparison", "operators": ["<", "<="], "left_exact": ["$VAR"]},
        {"type": "binary_comparison", "operators": ["<", "<="], "right_exact": ["$VAR"]}
      ],
      "manual_string_sanitization":[
        {
          "type": "function_has_method_call",
          "method": "replace",
          "args_contain": [";", "&"]
        }
      ],
      "null_checked": [
        {"type": "var_truthiness_check", "scope": "enclosing", "require_state": "truthy"},
        {"type": "var_falsy_guard_clause"}
      ],
      "safe_metadata_extraction": [
        {"type": "receiver_of_method", "method": "getSize"},
        {"type": "receiver_of_method", "method": "getContentType"}
      ],
      "xxe_safe_configuration": [
        {"type": "function_has_call_matching_ast", "call": ["setFeature"], "contains_string_containing": ["disallow-doctype-decl"]},
        {"type": "function_has_call_matching_ast","call": ["setFeature"],"contains_names": ["XMLConstants.FEATURE_SECURE_PROCESSING"]}
      ],
      "curl_non_url_option": []
  },
  "patterns": {
    "active_debug": {
      "forbidden_functions": [
        {
          "type": "call_matches_ast",
          "call": ["setDebug", "enableDebug"],
          "exact_args_count": 1,
          "contains_booleans": ["true"]
        }
      ]
    },
    "insecure_permission_assignment": {
      "forbidden_functions": [
          "Files.createTempDirectory",
          {
            "type": "call_matches_ast",
            "call": ["setWritable", "setExecutable", "setReadable"],
            "exact_args_count": 2,
            "args_boolean_sequence": ["true", "false"]
          }
        ]
      },
      "insecure_certificate_validation": {
        "bad_function_defs": [
          {
            "name": "verify",
            "param": "hostname",
            "return_expr": "true"
          }
        ],
        "forbidden_function_defs": [
            {
              "name": "checkClientTrusted",
              "exact_body": "{}"
            },
            {
              "name": "checkServerTrusted",
              "exact_body": "{}"
            }
          ]
    },
    "unsafe_deserialization_kwargs":{},
    "unsafe_dict_access":{},
    "unsafe_array_access": {
      "forbidden_subscripts": ["args","array","buffer"]
    }
  }
}