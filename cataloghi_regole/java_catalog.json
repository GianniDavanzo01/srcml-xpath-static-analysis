      "*.ObjectInputStream.readUnshared",
      "*.XMLDecoder.readObject",
      "*.XStream.fromXML",
      "*.Yaml.load",
      "*.Kryo.readObject",
      "*.Kryo.readClassAndObject"
    ],
    "insecure_temp_functions": [
      {
        "type": "call_matches_ast",
        "call": [
          "*.File"
        ],
        "contains_string_containing": [
          "java.io.tmpdir"
        ]
      }
    ],
    "insecure_cookie_configuration": [
      "*.HttpServletResponse.addCookie"
    ],
    "insecure_network_protocols": [
      "*.FTPClient",
      "*.TelnetClient",
      "*.POP3Client"
    ],
    "logging_calls_with_sensitive_content": [
      {
        "type": "call_matches_ast",
        "call": [
          "*.Logger.debug",
          "*.Logger.info",
          "*.Logger.warn",
          "*.Logger.warning",
          "*.Logger.error",
          "*.Logger.severe",
          "*.Logger.trace"
        ],
        "contains_any_name": [
          "password",
          "Secret",
          "auth_token",
          "authtoken",
          "access_token",
          "accesstoken",
          "api_key",
          "apikey",
          "private_key",
          "privatekey"
        ]
      }
    ],
    "obsolete_functions": [
      "Thread.stop",
      "Thread.suspend",
      "Thread.resume",
      "*.DataInputStream.readLine"
    ],
    "weak_password_hashing": [
      {
        "type": "call_matches_ast",
        "call": [
          "*.MessageDigest.getInstance"
        ],
        "case_insensitive": true,
        "contains_string_containing": [
          "MD5",
          "SHA-1"
        ],
        "contains_any_name": [
          "password",
          "passwd",
          "pwd"
        ]
      }
    ],
    "return_value_must_be_checked": [
      "*.File.delete",
      "*.File.mkdir",
      "*.File.mkdirs",
      "*.File.createNewFile",
      "*.File.renameTo",
      "*.File.setExecutable",
      "*.File.setReadable",
      "*.File.setWritable",
      "*.File.setReadOnly",
      "String.replace",
      "String.replaceAll",
      "String.replaceFirst",
      "String.trim",
      "*.URLEncoder.encode",
      "*.Signature.verify",
      "*.MessageDigest.isEqual",
      "*.Lock.tryLock",
      "*.Semaphore.tryAcquire",
      "*.Matcher.matches",
      "*.Matcher.find"
    ],
    "jackson_deserializers": ["*.ObjectMapper.readValue"]
  },
  "excluded_functions": {
    "safe_prng_exceptions": [
      "*.SecureRandom"
    ],
    "eval_false_positive_exceptions": []
  },
  "xpath_rules": {
    "off_by_one_loop_condition": [
        ".//src:condition[parent::src:while or parent::src:do or parent::src:control/parent::src:for]//src:operator[text()='<='][following-sibling::*[1][(self::src:name and src:name[last()][text()='length']) or (self::src:call and src:name/src:name[last()][text()='length' or text()='size'])]][not(following-sibling::*[2][self::src:operator and text()='-'])]"
    ]
  },
  "sanitizers": {
    "cast_to_integer": [
      "Integer.parseInt",
      "Integer.valueOf",
      "Long.parseLong",
      "Long.valueOf"
    ],
    "path_sanitizers": [
      "*.getCanonicalPath",
      "*.getCanonicalFile",
      "*.FilenameUtils.getName"
    ],
    "XSS_sanitizers": [
      "*.HtmlUtils.htmlEscape",
      "*.StringEscapeUtils.escapeHtml4",
      "*.Encode.forHtml"
    ],
    "url_encode_sanitizers": [
      "*.URLEncoder.encode"
    ],
    "crlf_sanitizers": [
      "*.encodeForHTTPHeader",
      "*.URLEncoder.encode",
      "*.StringUtils.replace",
      "*.StringEscapeUtils.escapeHtml4"
    ],
    "ldap_escape_sanitizers": [
      "*.encodeForLDAP",
      "*.encodeForDN",
      "*.LdapEncoder.filterEncode",
      "*.LdapEncoder.nameEncode"
    ],
    "crypto_decryption_functions": [
      "*.Cipher.doFinal",
      "*.Cipher.update"
    ],
    "shell_escape_sanitizers": []
  },
  "safe_contexts": {
    "try_block": [
      "try"
    ],
    "if_block": [
      "if"
    ],
    "safe_permission_defaults": [
      {
        "type": "matches_xpath",
        "xpath": ".//src:call[.//src:name[text()='PosixFilePermissions']]"
      }
    ],
    "secure_cookie_contexts": [
      {
        "type": "function_has_call_matching_ast",
        "call": [
          "*.setSecure"
        ],
        "contains_booleans": [
          "true"
        ]
      }
    ],
    "resource_safe_contexts": [
      {"type": "function_has_file_size_check", "size_properties": ["getSize"]},
      {
        "type": "binary_comparison",
        "operators": [
          "<",
          "<="
        ],
        "left_exact": [
          "$VAR"
        ]
      },
      {
        "type": "binary_comparison",
        "operators": [
          ">",
          ">="
        ],
        "right_exact": [
          "$VAR"
        ]
      }
    ],
    "starttls_upgrade": [
      {
        "type": "function_has_call_matching_ast",
        "call": [
          "*.execTLS"
        ]
      }
    ],
    "url_validation": [
      {
        "type": "condition_matches_xpath",
        "scope": "enclosing",
        "xpath": ".//src:call[.//src:name[last()][text()='isValid']][.//src:argument_list//src:name[text()='$VAR']]"
      }
    ],
    "allowlist_validation": [
      {
        "type": "membership_check",
        "scope": "enclosing",
        "require_var_left": true,
        "right_is_bare_identifier": true,
        "allowed_negation": [
          false
        ]
      }
    ],
    "file_extension_validation": [
      {
        "type": "receiver_of_method_with_arg",
        "method": "endsWith",
        "dangerous_values": [
          ".php",
          ".php3",
          ".php4",
          ".php5",
          ".exe",
          ".dll",
          ".so",
          ".sh",
          ".bat",
          ".cmd",
          ".cgi",
          ".pl",
          ".py",
          ".jar"
        ]
      }
    ],
    "bounds_checked_array_access": [
      {
        "type": "binary_comparison",
        "operators": [
          "<",
          "<="
        ],
        "left_exact": [
          "$VAR"
        ],
        "right_not_exact": [
          "0"
        ]
      },
      {
        "type": "binary_comparison",
        "operators": [
          ">",
          ">="
        ],
        "right_exact": [
          "$VAR"
        ],
        "left_not_exact": [
          "0"
        ]
      }
    ],
    "manual_string_sanitization": [
      {
        "type": "function_has_method_call",
        "call": ["*.replace"],
        "args_contain": [";", "&"]
      }
    ],
    "null_checked": [
      {
        "type": "var_truthiness_check",
        "scope": "enclosing",
        "require_state": "truthy"
      },
      {
        "type": "var_falsy_guard_clause"
      }
    ],
    "safe_metadata_extraction": [
      {
        "type": "receiver_of_method",
        "method": "getSize"
      },
      {
        "type": "receiver_of_method",
        "method": "getContentType"
      }
    ],
    "xxe_safe_configuration": [
      {
        "type": "function_has_call_matching_ast",
        "call": [
          "*.setFeature"
        ],
        "contains_string_containing": [
          "disallow-doctype-decl"
        ]
      },
      {
        "type": "function_has_call_matching_ast",
        "call": [
          "*.setFeature"
        ],
        "contains_names": [
          "XMLConstants.FEATURE_SECURE_PROCESSING"
        ]
      }
    ],
    "format_string_position": [
      {
        "type": "check_format_arg_position",
        "vulnerable_indices": {
          "*.format": 0,
          "*.printf": 0
        }
      }
    ],
    "return_value_used": [
      {
        "type": "node_matches_xpath",
        "xpath": "ancestor::src:condition or ancestor::src:return or ancestor::src:argument or ancestor::src:init or ancestor-or-self::*[preceding-sibling::src:operator[1][text()='=' or text()='+=' or text()='-=']]"
      }
    ],
    "alloc_size_positive_checked": [
      {
        "type": "binary_comparison",
        "operators": [
          ">"
        ],
        "left_exact": [
          "$VAR"
        ],
        "right_exact": [
          "0"
        ]
      },
      {
        "type": "binary_comparison",
        "operators": [
          ">="
        ],
        "left_exact": [
          "$VAR"
        ],
        "right_exact": [
          "1"
        ]
      },
      {
        "type": "binary_comparison",
        "operators": [
          "<"
        ],
        "left_exact": [
          "0"
        ],
        "right_exact": [
          "$VAR"
        ]
      },
      {
        "type": "binary_comparison",
        "operators": [
          "<="
        ],
        "left_exact": [
          "1"
        ],
        "right_exact": [
          "$VAR"
        ]
      }
    ],
    "deserialization_safe_contexts": [
      {
        "type": "matches_xpath",
        "xpath": ".//src:call[.//src:name[last()][text()='SafeConstructor']]"
      },
      {
        "type": "function_has_call_matching_ast",
        "call": [
          "*.setObjectInputFilter",
          "*.setupDefaultSecurity",
          "*.allowTypes",
          "*.allowTypesByWildcard"
        ]
      }
    ],
    "crypto_safe_contexts": [
      {
        "type": "function_has_call_matching_ast",
        "call": ["*.signWith"]
      }
    ],
