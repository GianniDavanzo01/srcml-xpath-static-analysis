      "*.ResponseEntity.internalServerError.body",
      "*.ResponseStatusException",
      "*.ModelAndView.addObject", "*.Model.addAttribute",
      "*.RedirectAttributes.addFlashAttribute"
    ]
  },
  {
    "type": "matches_xpath",
    "xpath": "ancestor::src:return[1][ancestor::src:function[1][src:annotation/src:name[text()='GetMapping' or text()='PostMapping' or text()='PutMapping' or text()='DeleteMapping' or text()='PatchMapping' or text()='RequestMapping' or text()='ExceptionHandler' or text()='ResponseBody'] or ancestor::src:class[1]/src:annotation/src:name[text()='RestController']]]"
  },
  { "type": "method_call", "method": "printStackTrace",
    "arg_call_matches": ["*.HttpServletResponse.getWriter", "*.HttpServletResponse.getOutputStream"] 
  }
],
    "exception_console_output": [
    {
      "type": "call_with_var_arg",
      "call": [
        "System.out.println", "System.out.print", "System.out.printf", "System.out.format",
        "System.err.println", "System.err.print", "System.err.printf", "System.err.format"
      ]
    },
    { "type": "method_call", "method": "printStackTrace", "arg_count_max": 0 }
  ],
    "logging_functions": [
      {
        "type": "call_with_var_arg",
        "call": [
          "*.Logger.info",
          "*.Logger.error",
          "*.Logger.warn",
          "*.Logger.warning",
          "*.Logger.severe",
          "*.Logger.debug",
          "*.Logger.trace",
          "System.out.println",
          "System.err.println"
        ]
      }
    ],
  "unbounded_resource_read": [
      {"type": "method_call", 
      "method": ["read", "readAllBytes", "*.MultipartFile.transferTo", "*.MultipartFile.getBytes"]}
    ],
    "format_string_functions": [
      {
        "type": "call_with_var_arg",
        "call": [
          "String.format",
          "System.out.printf",
          "System.err.printf",
          "System.out.format",
          "*.PrintStream.printf",
          "*.PrintStream.format",
          "*.Formatter.format"
        ]
      }
    ],
    "file_write": [
      {"type": "method_call", "method": ["transferTo", "write"]},
      {
        "type": "call_with_var_arg",
        "call": [
          "*.Files.copy", "*.Files.write", "*.Files.move",
          "*.FileOutputStream.write", "*.OutputStream.write", "*.BufferedOutputStream.write",
          "*.IOUtils.copy", "*.FileUtils.copyInputStreamToFile",
          "*.FileCopyUtils.copy", "*.StreamUtils.copy"
        ]
      }
    ],
    "resource_injection_sinks": [
      {
        "type": "call_with_var_arg",
        "call": [
          "Class.forName",
          "ClassLoader.loadClass",
          "ClassLoader.getResource",
          "ClassLoader.getResourceAsStream",
          "*.ResourceBundle.getBundle",
          "*.ServletContext.getResource",
          "*.ServletContext.getResourceAsStream"
        ]
      }
    ],
    "null_dereference": [
        {
          "type": "matches_xpath",
          "xpath": "not(parent::src:name/parent::src:decl) and (following-sibling::src:operator[1][text()='.'] | following-sibling::src:index[1])"
        }
      ],
    "authentication_sinks": [
      {
        "type": "call_with_var_arg",
        "call": [
          "*.LoginContext.login",
          "*.AuthenticationManager.authenticate",
          "*.HttpServletRequest.login",
          "*.Subject.doAs",
          "*.DriverManager.getConnection"
        ]
      }
    ],
    "array_index_use": [
      {
        "type": "matches_xpath",
        "xpath": "ancestor::src:index[not(parent::src:name/parent::src:decl)][not(parent::src:name/preceding-sibling::*[1][self::src:operator and text()='new'])]"
      }
    ],
    "array_alloc_size": [
      {
        "type": "matches_xpath",
        "xpath": "ancestor::src:index[parent::src:name/preceding-sibling::*[1][self::src:operator and text()='new']]"
      }
    ],
    "loop_condition": [
      {
        "type": "loop_condition"
      }
    ],
    "assert_conditions": [{"type": "matches_xpath", "xpath": "ancestor::src:assert"}],
    "search_path_sinks": [
      {
        "type": "call_with_var_arg",
         "call": [
          "System.setProperty", "System.load", "System.loadLibrary",
          "Runtime.load", "Runtime.loadLibrary",
          "Runtime.getRuntime.load", "Runtime.getRuntime.loadLibrary"
        ]
      }
    ],
    "sleep_functions": [
      {
        "type": "call_with_var_arg",
        "call": [
            "sleep", 
            "*.sleep", 
            "Thread.sleep", 
            "TimeUnit.SECONDS.sleep", 
            "TimeUnit.MILLISECONDS.sleep"
        ]
    }
    ],
    "crypto_key_sinks": [
      {
        "type": "call_with_var_arg", 
        "arg_index": 0,
        "call": ["*.SecretKeySpec", "*.PBEKeySpec", "*.IvParameterSpec"]
      }
    ],
    "memory_alloc_size": [
        {
        "type": "call_with_var_arg", "arg_index": 0,
        "call": ["*.ArrayList", "*.Vector", "*.HashMap", "*.HashSet",
                  "*.Hashtable", "*.LinkedHashMap", "*.ArrayDeque",
                  "*.PriorityQueue", "*.StringBuilder", "*.ByteArrayOutputStream"]}
      ]
  },
  "forbidden_functions": {
    "dangerous_functions": [
      "*.Runtime.halt", "*.Runtime.runFinalizersOnExit", "System.runFinalizersOnExit",
      "*.Unsafe.allocateMemory", "*.Unsafe.freeMemory", "*.Unsafe.copyMemory",
      "*.Unsafe.setMemory", "*.Unsafe.putAddress"
    ],
    "weak_hash_functions": [
      "*.DigestUtils.md5Hex", "*.DigestUtils.md5",
      "*.DigestUtils.sha1Hex", "*.DigestUtils.sha1",
      {
        "type": "call_matches_ast",
        "call": "*.MessageDigest.getInstance",
        "case_insensitive": true,
        "contains_string_containing": ["MD5","MD4","MD2","SHA-1","SHA1"]
      }
    ],
    "weak_ciphers_and_modes": [
      "*.Jwts.builder",
      {
        "type": "call_matches_ast",
        "call": "*.Cipher.getInstance",
        "case_insensitive": true,
        "contains_string_containing": [
          "DES",
          "DESede",
          "RC2",
          "RC4",
          "Blowfish",
          "ECB"
        ]
      }
    ],
    "weak_prngs": [
      "Math.random",
      "*.Random"
    ],
    "weak_key_generation": [
      {
        "type": "call_matches_ast",
        "call": [
          "*.KeyPairGenerator.initialize",
          "*.KeyGenerator.init"
        ],
        "arg_less_than": 2048
      }
    ],
    "dynamic_code_execution": [
      "*.ScriptEngine.eval",
      "*.GroovyShell.evaluate",
      "*.ExpressionParser.parseExpression",
      "*.Ognl.getValue",
      "*.MVEL.eval",
      "*.JShell.eval",
      "*.SourceCodeAnalysis.wrappers",
      "*.runsource"
