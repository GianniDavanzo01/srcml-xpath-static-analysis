        "type": "call_with_var_arg",
        "call": [
          "logging.info",
          "logging.warning",
          "logging.error",
          "logging.debug",
          "*.logger.info",
          "*.logger.error"
        ]
      }
    ],
    "unbounded_resource_read": [
      {
        "type": "method_call",
        "method": "read"
      },
      {
        "type": "method_call",
        "method": "readlines"
      },
      {
        "type": "method_call",
