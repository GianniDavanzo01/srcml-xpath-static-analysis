        "path_sanitizers": ["secure_filename","os.path.basename","basename"],
        "cast_to_integer": ["int","float"],
        "shell_escape_sanitizers": ["shlex.quote","quote"],
        "XSS_sanitizers": ["markupsafe.escape", "flask.escape", "escape", "html.escape", "bleach.clean"],
        "url_encode_sanitizers": ["urllib.parse.quote", "urllib.parse.quote_plus"],
        "crlf_sanitizers": ["urllib.parse.quote","urllib.parse.quote_plus","werkzeug.urls.url_quote"],
        "ldap_escape_sanitizers":["ldap3.utils.conv.escape_filter_chars","ldap.filter.escape_filter_chars"]
    },
  "safe_contexts": {
    "sql_parameterization": [{"type": "parametrized_query"}],
    "try_block": ["try"],
    "if_block": ["if"],
    "safe_permission_defaults": [
        {"type": "call_with_kwarg", "call": ["os.makedirs"], "kwargs": {"mode": "0o700"}},
        {"type": "current_call_matches_ast", "call": ["os.chmod", "chmod"], "contains_names": ["stat.S_IRWXU"]},
        {"type": "current_call_matches_ast", "call": ["os.chmod", "chmod"], "contains_names": ["stat.S_IRUSR"]},
        {"type": "current_call_matches_ast", "call": ["os.chmod", "chmod"], "contains_names": ["stat.S_IWUSR"]}
        ],
    "secure_cookie_contexts": [
          {
            "type": "call_with_kwarg",
            "call": ["set_cookie", "response.set_cookie", "HttpResponse.set_cookie"],
            "kwargs": {
              "secure": "True",
              "httponly": "True"
            },
            "require": "all"
          }
        ],
      "non_security_hash_usage": [
          {"type": "call_with_kwarg", "call": ["md5", "sha1", "hashlib.new"], "kwargs": {"usedforsecurity": "False"}}
        ],
      "resource_safe_contexts": [
          {"type": "function_has_file_size_check","size_properties": ["file_size", "size","content_length"]},
          {"type": "binary_comparison", "operators": ["<", "<="], "left_exact": ["$VAR"]},
          {"type": "binary_comparison", "operators": ["<", "<="], "right_exact": ["$VAR"]},    
          {
            "type": "condition_matches_xpath",
            "xpath": ".//src:call[src:name[text()='len']]"
          }
        ],
        "starttls_upgrade": [
          {
            "type": "function_has_call_matching_ast",
            "call": ["starttls"]
          }
        ],
        "url_validation": [
          {
            "type": "condition_matches_xpath",
            "scope": "enclosing",
            "xpath": ".//src:call[.//src:name[text()='is_safe_url' or text()='url_has_allowed_host_and_scheme']][.//src:argument_list//src:name[text()='$VAR']]"
          }
        ],
        "allowlist_validation": [
          {
            "type": "membership_check",
            "scope": "enclosing",
            "require_var_left": true,
            "right_is_bare_identifier": true,
            "allowed_negation": [false]
          }
        ],
        "file_extension_validation": [
          {
            "type": "receiver_of_method_with_arg",
            "method": "endswith",
            "arg_value": ".png" 
          }
        ],
        "manual_string_sanitization": [
          {
            "type": "function_has_method_call",
            "method": "replace",
            "args_contain": [";", "&"]
          }
        ],
        "null_checked": [
          {"type": "var_truthiness_check", "scope": "enclosing", "require_state": "truthy"},
          {"type": "var_falsy_guard_clause"}
        ],
        "safe_metadata_extraction": [
          {"type": "var_has_attribute", "attribute": "size"},
          {"type": "var_has_attribute", "attribute": "content_length"},
          {"type": "var_has_attribute", "attribute": "content_type"}
        ],
        "xxe_safe_configuration": [
          {"type": "call_with_kwarg", "call": ["XMLParser"], "kwargs": {"resolve_entities": "False"}}
        ],
        "curl_non_url_option": [],
        "bounds_checked_array_access":[]
