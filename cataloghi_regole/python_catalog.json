  "forbidden_functions": {
    "socket_primitives": [
      "socket.socket",
      "*.socket.connect",
      "*.socket.bind",
      "*.socket.listen",
      "*.socket.accept",
      "*.socket.send",
      "*.socket.recv",
      "*.socket.sendto",
      "*.socket.recvfrom",
      "*.socket.sendmsg",
      "*.socket.recvmsg",
      "*.socket.setsockopt",
      "*.socket.getsockopt",
      "*.socket.getsockname",
      "*.socket.getpeername",
      "*.socket.shutdown",
      "socket.create_connection",
      "socket.create_server"
    ],
    "weak_ciphers_and_modes": [
      "*.DES.new",
      "*.modes.ECB",
      "*.modes.CBC",
      "*.padding.PKCS1v15"
    ],
    "weak_hash_functions": [
      "hashlib.md5",
      "hashlib.sha1",
      "hashlib.new"
    ],
    "weak_prngs": [
      "random.randint",
      "random.randrange",
      "random.random",
      "random.uniform",
      "random.getrandbits",
      "random.sample",
      "random.shuffle",
      "random.seed",
      "random.choice",
      "random.choices",
      {
        "type": "call_matches_ast",
        "call": ["os.urandom"],
        "contains_numbers": [
          "0",
          "1",
          "2",
          "4",
          "8",
          "16",
          "32"
        ]
      }
    ],
    "weak_key_generation": [
      {
        "type": "call_matches_ast",
        "call": [
          "*.RSA.generate",
          "Crypto.PublicKey.DSA.generate",
          "*.rsa.generate_private_key",
          "*.dsa.generate_private_key"
        ],
        "arg_less_than": 2048
      }
    ],
    "dynamic_code_execution": ["eval", "exec", "*.zip_importer.exec_module"],
    "unsafe_xml_parsers": [
      "xml.sax.make_parser",
      "xml.sax.parse",
      "xml.sax.parseString",
      "xml.etree.ElementTree.parse",
      "xml.etree.ElementTree.fromstring",
      "xml.dom.minidom.parse",
      "xml.dom.pulldom.parse"
    ],
    "unsafe_deserializers": [
      "pickle.load",
      "pickle.loads",
      "_pickle.load",
      "_pickle.loads",
      "cPickle.load",
      "cPickle.loads",
      "marshal.load",
      "marshal.loads",
      "shelve.open",
      "yaml.unsafe_load",
      "pandas.read_pickle",
      "pickle.Unpickler.load"
    ],
    "insecure_temp_functions": ["tempfile.mktemp"],
    "insecure_cookie_configuration": ["*.set_cookie"],
    "insecure_network_protocols": [
      "ftplib.FTP",
      "telnetlib.Telnet",
      "poplib.POP3",
      "imaplib.IMAP4",
      "smtplib.SMTP"
    ],
    "logging_calls_with_sensitive_content": [
      {
        "type": "call_matches_ast",
        "call": [
          "logging.debug",
          "logging.info",
          "logging.warning",
          "logging.error",
          "*.logger.debug",
          "*.logger.info",
          "*.logger.warning",
          "*.logger.error"
        ],
        "contains_any_name": [
          "password",
          "secret",
          "auth_token",
          "access_token",
          "api_key",
          "apikey",
          "private_key"
        ]
      }
    ],
    "obsolete_functions": ["os.tempnam", "os.tmpnam", "platform.linux_distribution"],
    "weak_password_hashing": [
      {
        "type": "call_matches_ast",
        "call": ["hashlib.md5", "hashlib.sha1"],
        "contains_any_name": [
          "password",
          "passwd",
          "pwd",
          "passphrase"
        ]
      }
    ],
    "insecure_default_permissions": [
      {
        "type": "call_matches_ast",
        "call": ["os.umask"],
        "exact_args_count": 1,
        "contains_numbers": [
          0
        ]
      }
    ],
    "return_value_must_be_checked": [
      "subprocess.call",
      "os.system",
      "os.fork",
      "subprocess.Popen",
      "urllib.parse.quote",
      "urllib.parse.quote_plus",
      "shlex.quote",
      "re.sub",
      "re.match",
      "re.search",
      "re.fullmatch",
      "hmac.compare_digest",
      "secrets.compare_digest"
    ],
    "buffer_overflow_function": []
  },
  "excluded_functions": {
    "safe_prng_exceptions": ["secrets.choice", "secrets.randbelow", "secrets.randbits"],
    "eval_false_positive_exceptions": ["context.eval", "ctx.eval"]
  },
  "forbidden_imports": {
    "weak_crypto_modules": ["md5", "Crypto.Cipher.DES"]
  },
  "xpath_rules": {
    "off_by_one_loop_condition": [".//src:while[./src:condition//src:operator[text()='<='] and ./src:condition//src:call[./src:name[text()='len']]]"]
  },
  "sanitizers": {
    "html_escape": [
      "markupsafe.escape",
      "flask.escape",
      "cgi.escape",
      "django.utils.html.escape",
      "django.utils.html.conditional_escape",
      "werkzeug.escape",
      "werkzeug.utils.escape",
      "*.escape_filter_chars",
      "*.escape_rdn",
      "html.escape"
    ],
    "path_sanitizers": ["*.secure_filename", "os.path.basename"],
    "cast_to_integer": ["int", "float"],
    "shell_escape_sanitizers": ["shlex.quote", "pipes.quote"],
    "XSS_sanitizers": [
      "markupsafe.escape",
      "flask.escape",
      "cgi.escape",
      "django.utils.html.escape",
      "django.utils.html.conditional_escape",
      "werkzeug.escape",
      "werkzeug.utils.escape",
      "html.escape",
      "bleach.clean"
    ],
    "url_encode_sanitizers": ["urllib.parse.quote", "urllib.parse.quote_plus"],
    "crlf_sanitizers": ["urllib.parse.quote", "urllib.parse.quote_plus", "werkzeug.urls.url_quote"],
    "ldap_escape_sanitizers": ["ldap3.utils.conv.escape_filter_chars", "ldap.filter.escape_filter_chars"],
    "crypto_decryption_functions": ["*.decrypt"]
  },
  "safe_contexts": {
    "sql_parameterization": [
      {
        "type": "parametrized_query",
        "call": ["*.cursor.execute", "*.cursor.executemany", "*.connection.execute", "*.conn.execute"],
        "placeholders": ["%s", "?"]
      }
    ],
    "try_block": ["try"],
    "if_block": ["if"],
    "safe_permission_defaults": [
      {
        "type": "call_with_kwarg",
        "call": ["os.makedirs"],
        "kwargs": {
          "mode": "0o700"
        }
      },
      {
        "type": "current_call_matches_ast",
        "call": ["os.chmod"],
        "contains_names": ["stat.S_IRWXU"]
      },
      {
        "type": "current_call_matches_ast",
        "call": ["os.chmod"],
        "contains_names": ["stat.S_IRUSR"]
      },
      {
        "type": "current_call_matches_ast",
        "call": ["os.chmod"],
        "contains_names": ["stat.S_IWUSR"]
      }
    ],
    "secure_cookie_contexts": [
      {
        "type": "call_with_kwarg",
        "call": ["*.set_cookie"],
        "kwargs": {
          "secure": "True",
          "httponly": "True"
        },
        "require": "all"
      }
    ],
    "non_security_hash_usage": [
      {
        "type": "call_with_kwarg",
        "call": ["hashlib.md5", "hashlib.sha1", "hashlib.new"],
        "kwargs": {
          "usedforsecurity": "False"
        }
      }
    ],
    "resource_safe_contexts": [
      {
        "type": "function_has_file_size_check",
        "size_properties": ["file_size", "size", "content_length"]
      },
      {
        "type": "binary_comparison",
        "operators": ["<", "<="],
        "left_exact": ["$VAR"]
      },
      {
        "type": "binary_comparison",
        "operators": ["<", "<="],
        "right_exact": ["$VAR"]
      },
      {
        "type": "condition_matches_xpath",
        "xpath": ".//src:call[src:name[text()='len']]"
      }
    ],
    "starttls_upgrade": [
      {
        "type": "function_has_call_matching_ast",
        "call": ["*.starttls"]
      }
    ],
    "url_validation": [
      {
        "type": "condition_matches_xpath",
        "scope": "enclosing",
        "xpath": ".//src:call[.//src:name[text()='is_safe_url' or text()='url_has_allowed_host_and_scheme']][.//src:argument_list//src:name[text()='$VAR']]"
      }
    ],
    "allowlist_validation": [
      {
        "type": "membership_check",
        "scope": "enclosing",
        "require_var_left": true,
        "right_is_bare_identifier": true,
        "allowed_negation": [
          false
        ]
      }
    ],
    "file_extension_validation": [
      {
        "type": "receiver_of_method_with_arg",
        "method": "endswith",
        "dangerous_values": [
          ".php",
          ".php3",
          ".php4",
          ".php5",
          ".exe",
          ".dll",
          ".so",
          ".sh",
          ".bat",
          ".cmd",
          ".cgi",
          ".pl",
          ".py",
          ".jar"
        ]
      }
    ],
    "manual_string_sanitization": [
      {
        "type": "function_has_method_call",
        "call": "*.replace",
        "args_contain": [";", "&"]
      }
    ],
    "null_checked": [
      {
        "type": "var_truthiness_check",
        "scope": "enclosing",
        "require_state": "truthy"
      },
      {
        "type": "var_falsy_guard_clause"
      }
    ],
    "safe_metadata_extraction": [
      {
        "type": "var_has_attribute",
        "attribute": "size"
      },
      {
        "type": "var_has_attribute",
        "attribute": "content_length"
      },
      {
        "type": "var_has_attribute",
        "attribute": "content_type"
      }
    ],
    "xxe_safe_configuration": [
      {
        "type": "call_with_kwarg",
        "call": ["*.XMLParser"],
        "kwargs": {
          "resolve_entities": "False"
        }
      }
    ],
    "format_string_position": [
      {
        "type": "check_format_arg_position",
        "vulnerable_indices": {
          "logging.info": 0,
          "logging.warning": 0,
          "logging.error": 0,
          "logging.debug": 0,
          "*.logger.info": 0,
          "*.logger.warning": 0,
          "*.logger.error": 0,
          "*.printf": 0,
          "*.format": 0
        }
      }
    ],
    "return_value_used": [
      {
        "type": "node_matches_xpath",
        "xpath": "ancestor::src:condition or ancestor::src:return or ancestor::src:argument or ancestor::src:with or ancestor-or-self::*[preceding-sibling::src:operator[1][text()='=' or text()='+=' or text()='-=']]"
      },
      {
        "type": "call_with_kwarg",
        "call": ["subprocess.call", "subprocess.Popen"],
        "kwargs": {
          "check": "True"
        }
      }
    ],
    "curl_non_url_option": [],
    "bounds_checked_array_access": [],
    "alloc_size_positive_checked": []
  },
  "patterns": {
    "active_debug": {
      "forbidden_calls_with_kwargs": [
        {
          "call": "*.run",
          "kwargs": {
            "debug": "True"
          }
        }
      ],
      "bad_assignments": {
        "*.debug": "True"
      }
    },
    "insecure_permission_assignment": {
      "forbidden_functions": [
        "os.makedirs",
        "tempfile.mkdtemp",
        {
          "type": "call_matches_ast",
          "call": ["os.chmod"],
          "contains_numbers": [
            "0",
            "0000",
            "0o000",
            "755",
            "0o755",
            "777",
            "0o777",
            "0o400",
            "128",
            "664",
            "0o644"
          ]
        }
      ]
    },
    "insecure_certificate_validation": {
      "forbidden_calls_with_kwargs": [
        {
          "call": [
            "requests.get",
            "requests.post",
            "requests.put",
            "requests.delete",
            "requests.head",
            "requests.patch",
            "requests.request",
            "*.session.get",
            "*.session.post"
          ],
          "kwargs": {
            "verify": "False"
          }
        }
      ],
      "bad_assignments": {
        "*.verify_mode": "ssl.CERT_NONE",
        "*.check_hostname": "False"
      },
      "forbidden_functions": [
        "ssl.wrap_socket",
        {
          "type": "call_matches_ast",
          "call": ["ssl._create_unverified_context"],
          "exact_args_count": 0
        },
        {
          "type": "call_matches_ast",
          "call": ["ssl._create_stdlib_context"],
          "exact_args_count": 0
        }
      ]
    },
    "unsafe_deserialization_kwargs": {
      "forbidden_calls_with_kwargs": [
        {
          "call": ["numpy.load"],
          "kwargs": {
            "allow_pickle": "True"
          }
        }
      ]
    },
    "unsafe_dict_access": {
      "forbidden_subscripts": ["*.request.form", "*.request.args", "os.environ"]
    },
    "assignment_in_condition": {
      "xpath_rules": [".//src:condition/src:expr[src:operator[text()='='] and not(src:operator[text()='==' or text()='!=' or text()='<' or text()='>' or text()='<=' or text()='>=' or text()='&&' or text()='||'])]"]
    },
    "string_to_int_propagation": {
      "propagate_only_through_calls": [
        "int",
        "float",
        "*.strip",
        "*.lstrip",
        "*.rstrip"
      ]
    },
    "use_after_free_check": {}
  }
}