        "type": "method_call",
        "method": "save"
      }
    ],
    "resource_injection_sinks": [
      {
        "type": "call_with_var_arg",
        "call": [
          "__import__",
          "importlib.import_module",
          "flask.send_file",
          "flask.send_static_file",
          "django.utils.module_loading.import_string",
          "urllib.request.urlopen"
        ]
      }
    ],
    "null_dereference": [
      {
        "type": "matches_xpath",
        "xpath": "following-sibling::src:operator[1][text()='.'] | following-sibling::src:index[1]"
      }
    ],
    "authentication_sinks": [
      {
        "type": "call_with_var_arg",
        "call": [
