      "os_command_execution": [
          {"type": "call_with_var_arg", "call": ["subprocess.run", "subprocess.Popen", "subprocess.call", "subprocess.check_output",
                                                  "os.system", "os.popen", "os.execv", "os.execl", "os.spawnl", "os.spawnv",
                                                  "pty.spawn", "commands.getoutput", "commands.getstatusoutput"
                                                  ]}
          ],
      "file_system_access": [
          {
            "type": "call_with_var_arg",
            "call": ["open", "send_file", "send_static_file", "os.remove", "os.rmdir", "shutil.rmtree",
                    "FileResponse", "flask.send_from_directory", "django.http.FileResponse"]
          }
          ],
      "path_concatenation": [
        {
            "type": "concat",
            "requires_literal_any": ["/", "\\", ".."],
            "requires_text_any": ["open", "os.os.path", "shutil.", "Path", "send_file", "FileResponse", "read", "write"]
          },
          {
            "type": "fstring",
            "requires_literal_any": ["/", "\\", ".."],
            "requires_text_any": ["open", "os.path", "shutil.", "Path", "send_file", "FileResponse", "read", "write"]
          },
          {
            "type": "call_with_var_arg",
            "call": ["os.path.join", "join","Path", "pathlib.Path"]
          }
        ],
      "html_output": [
