{
  "sources": {
    "http_input": [
      "request.args", "request.GET", "request.POST", "request.files",
      "request.form", "request.data", "request.headers", "request.params",
      "request.base_url", "request.authorization", "request.cookies",
      "request.endpoint", "request.host", "request.host_url", "request.module",
      "request.path", "request.query_strings", "request.url", "request.values",
      "request.view_args","input","django.http.HttpRequest.GET", "django.http.HttpRequest.POST"
    ]
  },
    "sinks": {
      "sql_execution": [
          {"type": "call_with_var_arg", "call": ["execute","executemany"]}
          ],
      "os_command_execution": [
          {"type": "call_with_var_arg", "call": ["subprocess.run", "subprocess.Popen", "subprocess.call","subprocess.check_output","os.system","os.popen","os.execv", "os.execl"]}
          ],
      "file_system_access": [
          {
            "type": "call_with_var_arg",
            "call": ["open", "send_file", "send_static_file", "os.remove", "os.rmdir", "shutil.rmtree"]
          },
          {
            "type": "call_with_var_arg",
            "call": ["open", "send_file"]
          }
          ],
      "path_concatenation": [
          {"type": "concat","requires_text_any": ["/", "\\", ".."]},
          {"type": "fstring","requires_text_any": ["/", "\\", ".."]},
          {
            "type": "call_with_var_arg",
            "call": ["os.path.join", "join"]
          }
        ],
      "html_output": [
        {
          "type": "call_with_var_arg",
          "call": [
            "make_response","Response","HttpResponse",
            "HttpResponseBadRequest","HttpResponseNotFound","HttpResponseForbidden",
            "Markup","mark_safe","render_template_string"
          ]
        }
        ],
      "http_redirect": [
      {
        "type": "call_with_var_arg",
        "call": [
          "redirect",
          "HttpResponseRedirect",
          "HttpResponsePermanentRedirect",
          "RedirectResponse"
        ]
      }
    ],
    "http_request": [
      {
        "type": "call_with_var_arg",
        "call": [
          "requests.get", "requests.post", 
          "requests.request","requests.put","urllib.request.urlopen", "urlopen",
          "httpx.get", "httpx.post","session.get","session.post"
        ]
      }
    ],
    "http_header_setters": [
        {
        "type": "call_with_var_arg",
        "call":[
          "BaseHTTPRequestHandler.send_header","HttpResponse.set_cookie","Response.set_cookie",
          "flask.Response.set_cookie","django.http.HttpResponse.set_cookie","headers.add","set_cookie"
        ]
      }
    ],
      "ldap_execution": [
        {
          "type": "call_with_var_arg",
          "call": ["ldap3.Connection.search","ldap_connection.search_s","ldap.search_s","ldap.initialize"]
        }
      ]
  },
    "forbidden_functions": {
        "socket_primitives": [
          "socket.socket","socket.connect","socket.bind","socket.listen",
          "socket.accept","socket.send","socket.recv","socket.sendto",
          "socket.recvfrom","socket.sendmsg","socket.recvmsg","socket.setsockopt",
          "socket.getsockopt","socket.getsockname","socket.getpeername","socket.shutdown"
        ],
        "weak_ciphers_and_modes": ["DES.new", "modes.ECB", "modes.CBC", "padding.PKCS1v15"],
        "weak_hash_functions": ["md5", "sha1","sha256", "hashlib.new"],
        "weak_prngs": ["random.randint","random.randrange","random.random","random.uniform",
          "random.getrandbits","random.sample","random.shuffle","random.seed","choice","random.choices",
          {
            "type": "call_matches_ast", 
            "call": ["urandom"], 
            "contains_numbers": ["0", "1", "2", "4", "8", "16", "32"]
          }
        ],
        "weak_key_generation": [
          {
            "type": "call_matches_ast",
            "call": ["RSA.generate", "DSA.generate", "rsa.generate_private_key", "dsa.generate_private_key"
            ],
            "arg_less_than": 2048
          }
        ],
        "dynamic_code_execution": ["eval", "exec","zip_importer.exec_module"],
        "unsafe_xml_parsers": [
          "xml.sax.make_parser","xml.sax.parse","xml.sax.parseString",
          "xml.etree.ElementTree.parse","xml.etree.ElementTree.fromstring","xml.dom.minidom.parse","xml.dom.pulldom.parse"
        ],
        "unsafe_deserializers": [
          "pickle.load", "pickle.loads","_pickle.load", "_pickle.loads","cPickle.load", "cPickle.loads",
          "marshal.load", "marshal.loads","shelve.open","yaml.unsafe_load","pandas.read_pickle"
        ],
        "insecure_temp_functions": ["tempfile.mktemp","mktemp"],
        "insecure_cookie_configuration":["set_cookie","response.set_cookie","HttpResponse.set_cookie"],

        "insecure_network_protocols": ["ftplib.FTP","telnetlib.Telnet","poplib.POP3","imaplib.IMAP4","smtplib.SMTP"],  
        "logging_calls_with_sensitive_content": [
          {
            "type": "call_matches_ast",
            "call": ["logging.debug", "logging.info", "logging.warning", "logging.error",
                      "logger.debug", "logger.info", "logger.warning", "logger.error"],
            "contains_any_name": ["password", "Password", "pwd", "secret", "Secret",
                                "token", "Token", "api_key", "apikey", "private_key"]
          }
        ]
      },

    "excluded_functions": {
      "safe_prng_exceptions": ["secrets.choice","secrets.randbelow","secrets.randbits"],
      "eval_false_positive_exceptions": ["context.eval","ctx.eval"]
    },
    "sanitizers": {
        "html_escape": ["escape", "escape_filter_chars", "escape_rdn"],
        "path_sanitizers": ["secure_filename","os.path.basename","basename"],
        "cast_to_integer": ["int","float"],
        "shell_escape_sanitizers": ["shlex.quote","quote"],
        "XSS_sanitizers": ["markupsafe.escape", "flask.escape", "escape", "html.escape", "bleach.clean"],
        "url_validation": ["url_has_allowed_host_and_scheme","is_safe_url"],
        "crlf_sanitizers": ["urllib.parse.quote","urllib.parse.quote_plus","werkzeug.urls.url_quote"],
        "ldap_escape_sanitizers":["ldap3.utils.conv.escape_filter_chars","ldap.filter.escape_filter_chars"]
    },
  "safe_contexts": {
    "sql_parameterization": [{"type": "parametrized_query"}],
    "try_block": ["try"],
    "safe_permission_defaults": [
        {"type": "call_with_kwarg", "call": ["os.makedirs"], "kwargs": {"mode": "0o700"}},
        {"type": "current_call_matches_ast", "call": ["os.chmod", "chmod"], "contains_names": ["stat.S_IRWXU"]},
        {"type": "current_call_matches_ast", "call": ["os.chmod", "chmod"], "contains_names": ["stat.S_IRUSR"]},
        {"type": "current_call_matches_ast", "call": ["os.chmod", "chmod"], "contains_names": ["stat.S_IWUSR"]}
        ],
    "secure_cookie_contexts": [
          {
            "type": "call_with_kwarg",
            "call": ["set_cookie", "response.set_cookie", "HttpResponse.set_cookie"],
            "kwargs": {
              "secure": "True",
              "httponly": "True"
            },
            "require": "all"
          }
        ],
      "resource_safe_contexts": [
          {
            "type": "function_has_file_size_check",
            "size_properties": ["file_size", "size"]
          },
          {
            "type": "condition_matches_xpath",
            "xpath": ".//src:call[src:name[text()='len']]"
          }
        ],
        "starttls_upgrade": [
          {
            "type": "function_has_call_matching_ast",
            "call": ["starttls"]
          }
        ]
  },
  "patterns": {
    "active_debug": {
      "forbidden_calls_with_kwargs": [
        {
          "call": "run",
          "kwargs": {"debug": "True"}
        }
      ],
      "bad_assignments": {
        "debug": "True"
      }
    },
    "insecure_permission_assignment": {
      "forbidden_functions": [
        "os.makedirs",
        "tempfile.mkdtemp",
        {
          "type": "call_matches_ast",
          "call": ["os.chmod"],
          "contains_numbers": ["0", "0000", "0o000", "755", "0o755", "777", "0o777", "0o400", "128", "664", "0o644"]
        }
      ],
      "local_var_forbidden_calls": [
        {
          "call": ["os.chmod"],
          "forbidden_numbers": ["0", "0000", "0o000", "755", "0o755", "777", "0o777", "0o400", "128", "664", "0o644"]
        }
      ]
    },
    "insecure_certificate_validation": {
      "forbidden_calls_with_kwargs": [
        {
          "call": ["requests.get", "requests.post", "requests.put", "requests.delete", "requests.head", "requests.patch", "requests.request", "session.get", "session.post"],
          "kwargs": {"verify": "False"}
        }
      ],
      "bad_assignments": {
        "verify_mode": "ssl.CERT_NONE",
        "check_hostname": "False"
      },
      "forbidden_functions": [
          "ssl.wrap_socket",
          {
            "type": "call_matches_ast",
            "call": ["ssl._create_unverified_context"],
            "exact_args_count": 0
          },
          {
            "type": "call_matches_ast",
            "call": ["ssl._create_stdlib_context"],
            "exact_args_count": 0
          }
        ]
    },
    "unsafe_deserialization_kwargs":{
      "forbidden_calls_with_kwargs":[{"call": ["numpy.load"], "kwargs": {"allow_pickle": "True"}}]
    }
  }
}