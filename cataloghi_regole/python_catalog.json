          "type": "call_with_var_arg",
          "call": [
            "make_response","Response","HttpResponse",
            "HttpResponseBadRequest","HttpResponseNotFound","HttpResponseForbidden",
            "Markup","mark_safe","render_template_string"
          ]
        }
        ],
      "http_redirect": [
      {
        "type": "call_with_var_arg",
        "call": ["redirect","HttpResponseRedirect","HttpResponsePermanentRedirect","RedirectResponse"]
      }
    ],
    "http_request": [
      {
        "type": "call_with_var_arg",
        "call": ["requests.get", "requests.post", "requests.request","requests.put","urllib.request.urlopen", "urlopen",
